#!/usr/bin/env bash
# Pre-commit hook — SAST security checks + governance guards + concurrency warn
# Runs in parallel for speed. Blocks on secrets, CRITICAL/HIGH findings, and CLAUDE.md budget.
# Concurrency warn (step 0) is non-blocking — visibility only.
# Tool errors = warn + allow (defense-in-depth — agent catches what hook misses).
#
# Install: bash scripts/setup-hooks.sh
# Bypass:  git commit --no-verify

set -uo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
NC='\033[0m'
EXIT_CODE=0

# ─── 0. Concurrency warn — commits on main with multiple Claude sessions ─────
# Mirrors scripts/git-hooks/pre-commit-concurrency-warn.sh (R6 mitigation).
# Non-blocking by design — visibility is the value. Folded inline so that
# core.hooksPath=.githooks/ keeps both SAST and concurrency-warn behaviour.

CONCURRENCY_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
if [ "$CONCURRENCY_BRANCH" = "main" ]; then
    CONCURRENCY_STAGED="$(git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')"
    if [ "$CONCURRENCY_STAGED" -gt 1 ]; then
        CONCURRENCY_CLAUDE="$(ps -axo command 2>/dev/null | \
            grep -E "(^|/)claude( |$|-code-darwin|--dangerously|--output-format)" | \
            grep -v "grep" | \
            grep -v "node " | \
            wc -l | tr -d ' ')"
        if [ "$CONCURRENCY_CLAUDE" -gt 1 ]; then
            {
                echo ""
                printf "${YELLOW}${BOLD}⚠ COMMIT-CONCURRENCY WARNING${NC}\n"
                echo "  Branch       : main"
                echo "  Staged files : $CONCURRENCY_STAGED"
                echo "  Claude sessions detected : $CONCURRENCY_CLAUDE"
                echo ""
                echo "  Risk: another session may have staged files between your"
                echo "        git add and git commit. The resulting commit could"
                echo "        capture an unintended scope."
                echo ""
                echo "  Mitigation: use explicit pathspec"
                echo "    git commit -m \"msg\" -- <file1> <file2> [...]"
                echo ""
                echo "  After commit: verify with"
                echo "    git log -1 --stat"
                echo ""
                echo "  See .claude/rules/parallel-worktree-discipline.md § R6"
                echo ""
            } >&2
        fi
    fi
fi

echo "--- Pre-commit SAST checks ---"

# Temp files for parallel output
GL_OUT=$(mktemp)
SG_OUT=$(mktemp)
PSA_OUT=$(mktemp)
GL_EXIT=0
SG_EXIT=0
PSA_EXIT=0
PID_GL=""
PID_SG=""
PID_PSA=""

# ─── 1. Gitleaks — scan all staged files for secrets ──────────────────────────

if command -v gitleaks &>/dev/null; then
    (gitleaks protect --staged --redact --config .gitleaks.toml > "$GL_OUT" 2>&1) &
    PID_GL=$!
else
    echo -e "Secrets (gitleaks): ${YELLOW}SKIPPED (not installed)${NC}"
fi

# ─── 2. Semgrep — scan staged .js/.py/.sh files for SAST findings ─────────────

STAGED_CODE=$(git diff --cached --name-only --diff-filter=d -- '*.js' '*.py' '*.sh' 2>/dev/null || true)
if [ -n "$STAGED_CODE" ] && command -v semgrep &>/dev/null; then
    (echo "$STAGED_CODE" | tr '\n' '\0' | xargs -0 semgrep \
        --config p/security-audit \
        --severity ERROR \
        --error --quiet \
        --metrics off --disable-version-check \
        > "$SG_OUT" 2>&1) &
    PID_SG=$!
elif ! command -v semgrep &>/dev/null; then
    echo -e "SAST (semgrep): ${YELLOW}SKIPPED (not installed)${NC}"
fi

# ─── 3. PSScriptAnalyzer — scan staged .ps1/.psm1 files ─────────────────────

STAGED_PS=$(git diff --cached --name-only --diff-filter=d -- '*.ps1' '*.psm1' 2>/dev/null || true)
if [ -n "$STAGED_PS" ] && command -v pwsh &>/dev/null; then
    PSA_WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/psa.XXXXXX")
    PSA_SCRIPT="$PSA_WORKDIR/run.ps1"
    PSA_SETTINGS_PATH=$(printf '%s' "$PWD/scripts/PSScriptAnalyzerSettings.psd1" | sed "s/'/''/g")
    PS_FILE_LIST=$(
        printf '%s\n' "$STAGED_PS" |
            while IFS= read -r file; do
                [ -n "$file" ] || continue
                file=${file//\'/\'\'}
                printf "    '%s/%s'\n" "$PWD" "$file"
            done
    )
    {
        printf '$ErrorActionPreference = "Stop"\n'
        printf "\$settings = Import-PowerShellDataFile '%s'\n" "$PSA_SETTINGS_PATH"
        printf '$files = @(\n'
        printf '%s\n' "$PS_FILE_LIST"
        printf ')\n'
        printf 'try {\n'
        printf '    $customRulePaths = @()\n'
        printf '    foreach ($rulePath in @($settings.CustomRulePath)) {\n'
        printf '        if ([string]::IsNullOrWhiteSpace($rulePath)) { continue }\n'
        printf '        if (Test-Path -LiteralPath $rulePath) {\n'
        printf '            $customRulePaths += (Resolve-Path -LiteralPath $rulePath).Path\n'
        printf '            continue\n'
        printf '        }\n'
        printf '        $module = Get-Module -ListAvailable -Name $rulePath | Select-Object -First 1\n'
        printf '        if ($null -ne $module) {\n'
        printf '            $customRulePaths += $module.Path\n'
        printf '            continue\n'
        printf '        }\n'
        printf '        throw \"Custom rule path not found: $rulePath\"\n'
        printf '    }\n'
        printf '    $results = @()\n'
        printf '    foreach ($file in $files) {\n'
        printf '        $invokeParams = @{ Path = $file; IncludeDefaultRules = $true; IncludeRule = @($settings.IncludeRules); Severity = @($settings.Severity) }\n'
        printf '        if (@($settings.ExcludeRules).Count -gt 0) { $invokeParams.ExcludeRule = @($settings.ExcludeRules) }\n'
        printf '        if ($customRulePaths.Count -gt 0) {\n'
        printf '            $invokeParams.CustomRulePath = $customRulePaths\n'
        printf '            $invokeParams.RecurseCustomRulePath = $true\n'
        printf '        }\n'
        printf '        $results += Invoke-ScriptAnalyzer @invokeParams\n'
        printf '    }\n'
        printf '    if ($null -ne $results -and $results.Count -gt 0) {\n'
        printf '        $results | Format-Table -AutoSize\n'
        printf '        exit 1\n'
        printf '    }\n'
        printf '} catch {\n'
        printf '    Write-Error $_\n'
        printf '    exit 2\n'
        printf '}\n'
    } > "$PSA_SCRIPT"
    (
        pwsh -NoProfile -File "$PSA_SCRIPT" > "$PSA_OUT" 2>&1
        psa_rc=$?
        rm -rf "$PSA_WORKDIR"
        exit "$psa_rc"
    ) &
    PID_PSA=$!
elif [ -n "$STAGED_PS" ]; then
    echo -e "SAST (PSScriptAnalyzer): ${YELLOW}SKIPPED (pwsh not installed)${NC}"
fi

# ─── Wait for parallel tools ──────────────────────────────────────────────────

if [ -n "$PID_GL" ]; then
    wait "$PID_GL" 2>/dev/null
    GL_EXIT=$?
fi
if [ -n "$PID_SG" ]; then
    wait "$PID_SG" 2>/dev/null
    SG_EXIT=$?
fi
if [ -n "$PID_PSA" ]; then
    wait "$PID_PSA" 2>/dev/null
    PSA_EXIT=$?
fi

# ─── Report gitleaks results ──────────────────────────────────────────────────

if [ -n "$PID_GL" ]; then
    if [ "$GL_EXIT" -eq 1 ]; then
        echo -e "Secrets (gitleaks): ${RED}BLOCKED${NC}"
        cat "$GL_OUT"
        echo -e "${YELLOW}Fix:${NC} Remove secret, use \$env var or Key Vault. FP? Add fingerprint to .gitleaks.toml allowlist"
        EXIT_CODE=1
    elif [ "$GL_EXIT" -gt 1 ]; then
        echo -e "Secrets (gitleaks): ${YELLOW}ERROR (tool crash, allowing commit)${NC}"
        cat "$GL_OUT" >&2
    else
        echo -e "Secrets (gitleaks): ${GREEN}OK${NC}"
    fi
fi

# ─── Report Semgrep results ───────────────────────────────────────────────────

if [ -n "$PID_SG" ]; then
    if [ "$SG_EXIT" -eq 1 ]; then
        echo -e "SAST (semgrep): ${RED}BLOCKED${NC}"
        cat "$SG_OUT"
        echo -e "${YELLOW}Fix:${NC} Address findings above. FP? Add ${BOLD}# nosemgrep: <rule-id>${NC} inline"
        EXIT_CODE=1
    elif [ "$SG_EXIT" -gt 1 ]; then
        echo -e "SAST (semgrep): ${YELLOW}ERROR (tool crash, allowing commit)${NC}"
        cat "$SG_OUT" >&2
    else
        echo -e "SAST (semgrep): ${GREEN}OK${NC}"
    fi
elif [ -n "$STAGED_CODE" ] && command -v semgrep &>/dev/null; then
    echo -e "SAST (semgrep): ${GREEN}OK (no code files staged)${NC}"
fi

# ─── Report PSScriptAnalyzer results ─────────────────────────────────────────

if [ -n "$PID_PSA" ]; then
    if [ "$PSA_EXIT" -eq 1 ]; then
        echo -e "SAST (PSScriptAnalyzer): ${RED}BLOCKED${NC}"
        cat "$PSA_OUT"
        echo -e "${YELLOW}Fix:${NC} Address PSScriptAnalyzer findings. Settings: scripts/PSScriptAnalyzerSettings.psd1"
        EXIT_CODE=1
    elif [ "$PSA_EXIT" -gt 1 ]; then
        echo -e "SAST (PSScriptAnalyzer): ${YELLOW}ERROR (tool crash, allowing commit)${NC}"
        cat "$PSA_OUT" >&2
    else
        echo -e "SAST (PSScriptAnalyzer): ${GREEN}OK${NC}"
    fi
elif [ -n "$STAGED_PS" ] && command -v pwsh &>/dev/null; then
    echo -e "SAST (PSScriptAnalyzer): ${GREEN}OK (no PowerShell files staged)${NC}"
fi

# ─── Cleanup SAST temp files ─────────────────────────────────────────────────

rm -f "$GL_OUT" "$SG_OUT" "$PSA_OUT"

# ─── 3. Governance — CLAUDE.md budget (hard fail) ───────────────────────────

STAGED_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null || true)
CLAUDE_MD_BUDGET=50

for f in CLAUDE.md CLAUDE.md.disabled; do
    if echo "$STAGED_FILES" | grep -qx "$f"; then
        LINE_COUNT=$(git show ":$f" 2>/dev/null | wc -l | tr -d ' ')
        if [ "$LINE_COUNT" -gt "$CLAUDE_MD_BUDGET" ]; then
            echo -e "Governance (CLAUDE.md): ${RED}BLOCKED${NC} — ${LINE_COUNT} lines (max ${CLAUDE_MD_BUDGET})"
            echo -e "${YELLOW}Fix:${NC} CLAUDE.md must remain a short bootstrap. Move content to AGENTS.md, docs/, or SKILL.md."
            EXIT_CODE=1
        else
            echo -e "Governance (CLAUDE.md): ${GREEN}OK${NC} (${LINE_COUNT}/${CLAUDE_MD_BUDGET} lines)"
        fi
    fi
done

# ─── 4. Governance — MCP/integration co-presence (soft warning) ─────────────

MCP_PATTERN='\.mcp\.json$|\.mcp-servers\.json$'
if echo "$STAGED_FILES" | grep -qiE "$MCP_PATTERN"; then
    if ! echo "$STAGED_FILES" | grep -qx '.claude/integrations.md'; then
        echo -e "Governance (MCP): ${YELLOW}WARN${NC} — MCP/integration files changed but .claude/integrations.md not staged."
        echo "  If the active integration inventory changed, update .claude/integrations.md in the same commit."
    fi
fi

# ─── 5. Governance — infra/access co-presence (soft warning) ────────────────

INFRA_PATTERN='^infra/|^n8n/|^scripts/|^docker/|traefik|systemd|keyvault|keeper|^\.env$|/\.env$'
if echo "$STAGED_FILES" | grep -qiE "$INFRA_PATTERN"; then
    if ! echo "$STAGED_FILES" | grep -qx 'docs/codebase/services-and-access.md'; then
        echo -e "Governance (infra): ${YELLOW}WARN${NC} — Infra/access files changed but docs/codebase/services-and-access.md not staged."
        echo "  If endpoints, hostnames, ports, access methods, or secret locations changed, update the doc in the same commit."
    fi
fi

# ─── 6. Governance — new SKILL.md without MCP Routing (soft warning) ────────

NEW_SKILLS=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep '/SKILL\.md$' || true)
EXEMPT_SKILLS='lesson|session-gate|memory-consolidate|context-checkpoint|project-sync|pre-flight|rules-distill|template-sync|todo|sparc|brainstorming|skill-creator|create-agent-skills|context-manager|loupe-code-reviewer|every-style-editor|carl-manager|excalidraw-diagram|specification-architect'
DOMAIN_KEYWORDS='azure|m365|n8n|ghl|graph|keyvault|powershell|infra|api|webhook|foundry|search|speech|storage|rbac|cipp|quickbooks|airtable|analytics|gtm|playwright|mcp|tool|integration'

for skill_file in $NEW_SKILLS; do
    skill_dir=$(basename "$(dirname "$skill_file")")
    # Skip exempt skills
    if echo "$skill_dir" | grep -qiE "$EXEMPT_SKILLS"; then
        continue
    fi
    # Read staged content
    SKILL_CONTENT=$(git show ":$skill_file" 2>/dev/null || true)
    # Check if it looks like a domain skill
    if echo "$SKILL_CONTENT" | grep -qiE "$DOMAIN_KEYWORDS"; then
        # Check for MCP Routing section
        if ! echo "$SKILL_CONTENT" | grep -q '## MCP Routing'; then
            echo -e "Governance (skill): ${YELLOW}WARN${NC} — New domain skill ${BOLD}${skill_dir}${NC} added without '## MCP Routing'."
            echo "  If this skill recommends or uses MCPs, add an MCP Routing section."
            echo "  See AGENTS.md '### Gouvernance Des Skills Et MCP' for requirements."
        fi
    fi
done

# ─── Final verdict ───────────────────────────────────────────────────────────

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo -e "${RED}${BOLD}Commit blocked.${NC} Fix issues above or use ${BOLD}git commit --no-verify${NC} to bypass."
fi

exit $EXIT_CODE
